# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── Raw datasets (large, not versioned) ──────────────────────────────────────
# BRISC2025 + external MRI datasets (~1.4 GB). Download separately.
datasets/

# ── Model checkpoints & logs ─────────────────────────────────────────────────
*.pth
*.pt
*.onnx
*.h5
tb_logs/
*.log

# ── Experiment outputs (generated) ───────────────────────────────────────────
experiments/
notebooks/

# ── Literature-search cache (generated by research MCP tools) ───────────────
data/*.db

# ── LaTeX build artifacts (generated) ────────────────────────────────────────
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.lof
paper/*.lot
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
nul
